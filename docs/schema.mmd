erDiagram
    clienti ||--o{ parametri_anno : "ha parametri per anno"
    clienti ||--o{ voci : "ha righe di conto"
    clienti ||--o{ vendite : "ha vendite mensili"
    voci ||--o{ valori : "importo per anno"
    voci ||--o{ budget_var : "variazione budget per anno"
    voci ||--o{ cashflow : "importo per anno e mese"
    clienti ||--o{ cestino : "elementi eliminati"

    clienti {
        INTEGER id PK
        TEXT ragione_sociale
        TEXT partita_iva
        TEXT note
        INTEGER anno_base
        INTEGER anno_sync
        TEXT created_at
    }

    parametri_anno {
        INTEGER cliente_id PK, FK
        INTEGER anno PK
        REAL peso_vendite
        REAL inflazione
        REAL produttivita
        REAL imposte_budget
        REAL investimento
        REAL aumento_utile
        REAL saldo_iniziale_cf
    }

    voci {
        INTEGER id PK
        INTEGER cliente_id FK
        TEXT ambito
        TEXT sezione
        TEXT codice
        TEXT descrizione
        TEXT tipo
        INTEGER ordine
        INTEGER fissa
    }

    valori {
        INTEGER voce_id PK, FK
        INTEGER anno PK
        REAL importo
    }

    budget_var {
        INTEGER voce_id PK, FK
        INTEGER anno PK
        REAL valore
    }

    vendite {
        INTEGER cliente_id PK, FK
        INTEGER anno PK
        INTEGER mese PK
        REAL importo
    }

    cashflow {
        INTEGER voce_id PK, FK
        INTEGER anno PK
        INTEGER mese PK
        REAL importo
    }

    cestino {
        INTEGER id PK
        TEXT tipo
        INTEGER cliente_id
        TEXT cliente_nome
        TEXT etichetta
        TEXT dettaglio
        INTEGER n_dati
        TEXT dati_json
        TEXT data_eliminazione
        TEXT scade_il
    }